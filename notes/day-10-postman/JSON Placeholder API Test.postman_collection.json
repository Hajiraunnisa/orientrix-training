              "        pm.expect(comment.postId).to.eql(1);",
              "    });",
              "});",
              "",
              "pm.test('Comments have email field', function () {",
              "    var jsonData = pm.response.json();",
              "    jsonData.forEach(function (comment) {",
              "        pm.expect(comment.email).to.include('@');",
              "    });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/posts/1/comments",
          "host": ["{{base_url}}"],
          "path": ["posts", "1", "comments"]
        }
      }
    },
    {
      "name": "POST Create New Post",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Response has title', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.title).to.eql('Test Post Title');",
              "});",
              "",
              "pm.test('Response has body', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.body).to.eql('This is a test post body.');",
              "});",
              "",
              "pm.test('Response has userId', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.userId).to.eql(1);",
              "});",
              "",
              "pm.test('Response has new ID 101', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.id).to.eql(101);",
              "});",
              "",
              "if (pm.response.code === 201) {",
              "    var jsonData = pm.response.json();",
              "    pm.collectionVariables.set('created_post_id', jsonData.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"title\": \"Test Post Title\",\n    \"body\": \"This is a test post body.\",\n    \"userId\": 1\n}"
        },
        "url": {
          "raw": "{{base_url}}/posts",
          "host": ["{{base_url}}"],
          "path": ["posts"]
        }
      }
    },
