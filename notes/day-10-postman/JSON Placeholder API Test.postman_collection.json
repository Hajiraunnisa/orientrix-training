              "    pm.expect(jsonData.address.geo.lat).to.be.a('string');",
              "    pm.expect(jsonData.address.geo.lng).to.be.a('string');",
              "});",
              "",
              "pm.test('User has company', function () {",
              "    var jsonData = pm.response.json();",
